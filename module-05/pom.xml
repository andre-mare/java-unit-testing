		</profile>
		<profile>
			<id>security</id>
			<properties>
				<groups>security</groups>
			</properties>
		</profile>
		<profile>
			<id>integration</id>
			<properties>
				<groups>integration</groups>
			</properties>
		</profile>
	</profiles>

