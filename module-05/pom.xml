	<artifactId>module-05</artifactId>
	<name>Module 5: Controlling Order</name>

	<profiles>
		<profile>
			<id>fast</id>
			<properties>
				<groups>fast</groups>
			</properties>
		</profile>
		<profile>
			<id>no-slow</id>
			<properties>
				<excludedGroups>expected-failure-tests,slow</excludedGroups>
